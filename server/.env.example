DATABASE_URL=postgres://elyra:elyra-dev-password@localhost:5432/elyra
ELYRA_JWT_SECRET=replace-with-at-least-32-random-characters
ELYRA_SERVER_ADDR=127.0.0.1:8787
ELYRA_ACCESS_TOKEN_TTL_HOURS=24
RUST_LOG=elyra_server=info,tower_http=info

# Optional outbound mail relay. Registered users can send to any external
# address through the server when they have no local SMTP account configured.
# Leave ELYRA_SMTP_HOST empty to disable the relay.
# ELYRA_SMTP_HOST=smtp.example.com
# ELYRA_SMTP_PORT=587
# ELYRA_SMTP_SECURITY=starttls
# ELYRA_SMTP_USERNAME=no-reply@example.com
# ELYRA_SMTP_PASSWORD=app-password
# ELYRA_SMTP_FROM=no-reply@example.com
# ELYRA_SMTP_FROM_NAME=Elyra
