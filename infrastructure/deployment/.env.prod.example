# Production environment for infrastructure/deployment/docker-compose.prod.yml
#
# Copy this file to .env.prod and replace every placeholder before deploying:
#   cp infrastructure/deployment/.env.prod.example infrastructure/deployment/.env.prod
#
# Generate strong values with: openssl rand -hex 32
# Never commit .env.prod.

POSTGRES_DB=elyra
POSTGRES_USER=elyra
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-different-long-random-password
ELYRA_JWT_SECRET=replace-with-at-least-32-random-characters

# Website port on the host. Keep WEB_BIND=127.0.0.1 when Caddy terminates TLS,
# so the plain HTTP port is not reachable from the internet.
WEB_BIND=0.0.0.0
WEB_PORT=8080
RUST_LOG=elyra_server=info,tower_http=info

# --- Optional automatic HTTPS (Caddy) ---------------------------------------
# Set ELYRA_ENABLE_TLS=1, point ELYRA_DOMAIN at this server, and open 80/443.
# Then run: ./infrastructure/deployment/deploy.sh --tls
ELYRA_ENABLE_TLS=0
ELYRA_DOMAIN=mail.example.com

# --- Outbound mail relay (optional but recommended) -------------------------
# Registered users can send to any external address through this SMTP relay
# when they have no local mail account configured. Leave ELYRA_SMTP_HOST empty
# to disable the relay. Use a dedicated mailbox or transactional provider and
# publish SPF, DKIM and DMARC records for the sending domain.
#
# Security is "starttls" (port 587) or "tls" (port 465).
ELYRA_SMTP_HOST=
ELYRA_SMTP_PORT=587
ELYRA_SMTP_SECURITY=starttls
ELYRA_SMTP_USERNAME=
ELYRA_SMTP_PASSWORD=
ELYRA_SMTP_FROM=no-reply@example.com
ELYRA_SMTP_FROM_NAME=Elyra
