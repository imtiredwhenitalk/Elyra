# Development defaults. Copy to infrastructure/docker/.env for local overrides.
POSTGRES_DB=elyra
POSTGRES_USER=elyra
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Required by infrastructure/deployment/docker-compose.prod.yml
# POSTGRES_PASSWORD=use-a-long-random-password
# REDIS_PASSWORD=use-a-different-long-random-password
# ELYRA_JWT_SECRET=use-at-least-32-random-characters
# WEB_PORT=8080
