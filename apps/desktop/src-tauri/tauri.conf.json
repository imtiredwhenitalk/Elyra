{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elyra",
  "version": "0.3.0",
  "identifier": "com.elyra.desktop",
  "build": {
    "frontendDist": "../src",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Elyra — Private inbox",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": false,
    "publisher": "Elyra",
    "copyright": "© 2026 Elyra",
    "category": "Productivity",
    "shortDescription": "A private, local-first email workspace.",
    "longDescription": "Elyra brings your inbox, privacy and everyday communication into one calm desktop workspace. Mailbox logic runs in Rust, data stays on your device by default, and the Windows installer is available as MSI or NSIS.",
    "homepage": "https://github.com/imtiredwhenitalk/Elyra",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true
      },
      "wix": {
        "language": "en-US"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
